# This file is a template for the required environment variables.
# Copy this file to .env and fill in your actual credentials.

# The Google Cloud project ID to use for Datastore tests.
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# The Google AI API key for running the agent.
# You can create one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY="your-google-api-key"
